# Copy this file to .env and fill in real values. Never commit the real .env.

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://outfit_app:outfit_app@localhost:5432/outfit_app

# Claude API — used for garment/pin photo auto-tagging (vision_tagging.py)
ANTHROPIC_API_KEY=

# OpenWeatherMap — used for event weather snapshots (weather.py)
# Free key: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=

# Cloudflare R2 — used for photo storage (storage.py)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
